{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "progresstogether",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SENDER_EMAIL": "contact-form@progresstogether.net",
    "CONTACT_RECEIVER_EMAIL": "maryellen@progresstogether.net",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEjVKAtgubDV6LB-"
  }
}
